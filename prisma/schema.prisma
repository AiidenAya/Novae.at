generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String   @id @default(cuid())
  username                String?  @unique
  roles                   String[] @default(["user"])
  email                   String   @unique
  emailVerified           Boolean  @default(false)
  name                    String?
  avatar                  String?
  coverImage              String?
  bio                     String?
  pronouns                String?
  socials                 Json?
  featuredCharacterIds    String[] @default([])
  featuredFriendUsernames String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  characters          Character[]
  artworks            Artwork[]
  artworkCredits      ArtworkCredit[]
  authoredComments    Comment[]         @relation("AuthoredComments")
  profileComments     Comment[]         @relation("ProfileComments")
  species             Species[]
  favorites           Favorite[]
  followers           Follow[]          @relation("Following")
  following           Follow[]          @relation("Follower")
  invitesCreated      InviteCode[]      @relation("CreatedInvites")
  invitesUsed         InviteCode[]      @relation("UsedInvites")
  characterFolders    CharacterFolder[]
  favoriteFolders     FavoriteFolder[]
  notificationsReceived Notification[]  @relation("ReceivedNotifications")
  notificationsSent     Notification[]    @relation("SentNotifications")
  worlds               World[]
}

model Follow {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

model CharacterFolder {
  id         String      @id @default(cuid())
  name       String
  isPublic   Boolean     @default(true)
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters Character[]
}

model FavoriteFolder {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]
}

model Character {
  id                 String   @id @default(cuid())
  numId              Int      @unique @default(autoincrement())
  name               String
  slug               String   @unique
  description        String?
  avatarUrl          String?
  backgroundImageUrl String?
  isPublic           Boolean  @default(true)
  isDesigner         Boolean  @default(true)
  designerCredit     String?
  isWriter           Boolean  @default(true)
  writerCredit       String?
  birthdate          String?
  age                String?
  height             String?
  weight             String?
  mbti               String?
  kingdom            String?
  ethnicity          String?
  race               String?
  gender             String?
  orientation        String?
  customFieldName    String?
  custom             String?
  voiceClaimUrl      String?
  playlistUrl        String?
  spotifyPlaylistUrl String?
  summary            String?
  biography          String?
  sections           String?
  profileBlockOrder  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String?
  folder   CharacterFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  speciesId String?
  species   Species? @relation(fields: [speciesId], references: [id], onDelete: SetNull)

  baseCharacterId String?
  baseCharacter   Character?  @relation("CharacterVariants", fields: [baseCharacterId], references: [id], onDelete: Cascade)
  variantLabel    String?
  variants        Character[] @relation("CharacterVariants")

  artworks       Artwork[]      @relation("ArtworkCharacters")
  galleries      Gallery[]
  tags           CharacterTag[]
  colorPalettes  ColorPalette[]
  relationshipsA Relationship[] @relation("CharacterA")
  relationshipsB Relationship[] @relation("CharacterB")
  favorites      Favorite[]
  notifications  Notification[]

  worldId String?
  world   World? @relation(fields: [worldId], references: [id], onDelete: SetNull)
}

model Species {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters Character[]
}

model Artwork {
  id            String   @id @default(cuid())
  title         String?
  imageUrl      String
  thumbnailUrl  String?
  sensitiveType String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characters Character[]     @relation("ArtworkCharacters")
  worlds     World[]         @relation("ArtworkWorlds")
  credits    ArtworkCredit[]

  galleryImages      GalleryImage[]
  worldGalleryImages WorldGalleryImage[]
  favorites          Favorite[]
  notifications      Notification[]
}

model ArtworkCredit {
  id       String @id @default(cuid())
  position Int    @default(0)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  label String?
  url   String?

  createdAt DateTime @default(now())
}

model Gallery {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  images GalleryImage[]
}

model GalleryImage {
  id    String @id @default(cuid())
  order Int    @default(0)

  galleryId String
  gallery   Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([galleryId, artworkId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  characters CharacterTag[]
  worlds     WorldTag[]
}

model CharacterTag {
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
}

model ColorPalette {
  id   String @id @default(cuid())
  name String @default("Palette")

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  swatches ColorSwatch[]
}

model ColorSwatch {
  id    String  @id @default(cuid())
  hex   String
  label String?
  order Int     @default(0)

  paletteId String
  palette   ColorPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)
}

model Relationship {
  id          String  @id @default(cuid())
  type        String
  typeB       String?
  description String?

  status        String  @default("accepted")
  requestedById String?

  characterAId String
  characterA   Character @relation("CharacterA", fields: [characterAId], references: [id], onDelete: Cascade)

  characterBId     String?
  characterB       Character? @relation("CharacterB", fields: [characterBId], references: [id], onDelete: Cascade)
  externalName     String?
  externalImageUrl String?

  notifications Notification[]
}

model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedAt    DateTime?

  createdById String
  createdBy   User   @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: Cascade)

  usedById String?
  usedBy   User?   @relation("UsedInvites", fields: [usedById], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  recipientId String
  recipient   User   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("SentNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  artworkId String?
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  relationshipId String?
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)

  profileId String
  profile   User   @relation("ProfileComments", fields: [profileId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  worldId String?
  world   World? @relation(fields: [worldId], references: [id], onDelete: Cascade)

  artworkId String?
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  folderId String?
  folder   FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, characterId])
  @@unique([userId, worldId])
  @@unique([userId, artworkId])
}

model World {
  id                 String   @id @default(cuid())
  numId              Int      @unique @default(autoincrement())
  name               String
  slug               String   @unique
  description        String?
  avatarUrl          String?
  coverImageUrl      String?
  isPublic           Boolean  @default(true)
  isDesigner         Boolean  @default(true)
  designerCredit     String?
  isWriter           Boolean  @default(true)
  writerCredit       String?
  summary            String?
  biography          String?
  sections           String?
  profileBlockOrder  String?
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  baseWorldId String?
  baseWorld   World?  @relation("WorldVariants", fields: [baseWorldId], references: [id], onDelete: Cascade)
  variantLabel String?
  variants     World[] @relation("WorldVariants")

  locations Location[]
  characters Character[]
  maps       Map[]
  pins       Pin[]
  artworks       Artwork[]          @relation("ArtworkWorlds")
  galleries      WorldGallery[]
  tags           WorldTag[]
  colorPalettes  WorldColorPalette[]
  favorites      Favorite[]
}

model WorldTag {
  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([worldId, tagId])
}

model WorldColorPalette {
  id   String @id @default(cuid())
  name String @default("Palette")

  worldId String
  world   World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  swatches WorldColorSwatch[]
}

model WorldColorSwatch {
  id    String  @id @default(cuid())
  hex   String
  label String?
  order Int     @default(0)

  paletteId String
  palette   WorldColorPalette @relation(fields: [paletteId], references: [id], onDelete: Cascade)
}

model WorldGallery {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  worldId String
  world   World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  images WorldGalleryImage[]
}

model WorldGalleryImage {
  id    String @id @default(cuid())
  order Int    @default(0)

  galleryId String
  gallery   WorldGallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  @@unique([galleryId, artworkId])
}

model Location {
  id          String  @id @default(cuid())
  name        String
  description String?
  x           Float?
  y           Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worldId String
  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
}

model Map {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String?
  worldId   String
  world     World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  bounds    Json     @default("{}")
  pins      Pin[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pin {
  id          String   @id @default(cuid())
  worldId     String
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  mapId       String?
  map         Map?     @relation(fields: [mapId], references: [id], onDelete: SetNull)
  lat         Float
  lng         Float
  title       String?
  description String?
  status      String   @default("coming_soon")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}